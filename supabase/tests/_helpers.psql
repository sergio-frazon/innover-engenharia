-- Funções auxiliares de teste (incluídas por \ir em cada arquivo; somem no rollback)
create extension if not exists pgtap with schema extensions;
create schema if not exists tests;

create or replace function tests.criar_usuario(p_email text, p_papel text default 'campo', p_nome text default null)
returns uuid language plpgsql security definer set search_path = '' as $$
declare v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, encrypted_password, email_confirmed_at,
                          raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values (v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email,
          extensions.crypt('x', extensions.gen_salt('bf')), now(),
          jsonb_build_object('provider', 'email', 'providers', array['email'], 'papel', p_papel),
          jsonb_build_object('nome', coalesce(p_nome, p_email)), now(), now());
  return v_id;
end $$;

create or replace function tests.autenticar(p_id uuid)
returns void language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims', json_build_object('sub', p_id, 'role', 'authenticated')::text, true);
end $$;

create or replace function tests.sair()
returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end $$;

grant usage on schema tests to authenticated;
grant execute on all functions in schema tests to authenticated;

-- Cada teste começa sem os dados do seed (o rollback final os devolve)
do $$
begin
  execute (
    select 'truncate ' || string_agg(format('public.%I', tablename), ', ') || ' cascade'
      from pg_tables where schemaname = 'public'
  );
  delete from auth.identities;
  delete from auth.users;
  insert into public.categorias_financeiras (nome, tipo) values
    ('Materiais', 'despesa'), ('Mão de obra', 'despesa'), ('Equipamentos', 'despesa'),
    ('Serviços de terceiros', 'despesa'), ('Impostos e taxas', 'despesa'), ('Administrativo', 'despesa'),
    ('Outros', 'despesa'), ('Medição de contrato', 'receita'), ('Adiantamento do cliente', 'receita'), ('Outros', 'receita');
end;
$$;
